# Generated by ClashGate (clashgate). Do not edit by hand; regenerated on install/update.
# Dynamic blocks (controller, proxy-providers, proxies, listeners) are rendered from state files in /etc/clashgate.
global-ua: clash.meta
mode: rule
ipv6: true
unified-delay: true
tcp-concurrent: true
log-level: warning
find-process-mode: "off"

# 只为 GEOIP 规则。域名走外部规则集，不需要 geosite / geoip.dat
geodata-mode: false
geo-auto-update: true
geo-update-interval: 48
geox-url:
  mmdb: "https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb"

@@CONTROLLER@@

profile:
  store-selected: true

sniffer:
  enable: true
  force-dns-mapping: true
  parse-pure-ip: true
  override-destination: true
  sniff:
    HTTP:
      ports: [80, 8080-8880]
    TLS:
      ports: [443, 8443]
    QUIC:
      ports: [443, 8443]

dns:
  enable: true
  ipv6: true
  default-nameserver:
    - 8.8.8.8
    - 1.1.1.1
  nameserver:
    - https://doh.sb/dns-query
  proxy-server-nameserver:
    - https://doh.sb/dns-query

@@PROXY_PROVIDERS@@

@@PROXIES@@

rule-providers:
  AI-Global:
    type: http
    behavior: classical
    url: "https://cdn.jsdelivr.net/gh/VPSDance/ai-proxy-rules@main/rules/clash/global.yaml"
    path: ./ruleset/AI-Global.yaml
    interval: 86400
  AI-OpenAI:
    type: http
    behavior: classical
    url: "https://cdn.jsdelivr.net/gh/VPSDance/ai-proxy-rules@main/rules/clash/openai.yaml"
    path: ./ruleset/AI-OpenAI.yaml
    interval: 86400
  Twitter:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Twitter/Twitter.yaml"
    path: ./ruleset/Twitter.yaml
    interval: 86400
  Instagram:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/Instagram/Instagram.yaml"
    path: ./ruleset/Instagram.yaml
    interval: 86400
  China:
    type: http
    behavior: classical
    url: "https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Clash/China/China.yaml"
    path: ./ruleset/China.yaml
    interval: 86400

# 节点与订阅源通过 include-all 自动引入（含面板添加到 proxies: 与 proxy-providers: 的出站节点）
# 顺序：🚀 节点选择 → 🤖 AI → 📱 社交媒体 → 🇨🇳 中国 → 🐟 漏网之鱼（漏网之鱼最后）
proxy-groups:
  - name: "🚀 节点选择"
    type: select
    include-all: true
    proxies:
      - DIRECT
  - name: "🤖 AI"
    type: select
    include-all: true
    proxies:
      - "🚀 节点选择"
      - DIRECT
  - name: "📱 社交媒体"
    type: select
    include-all: true
    proxies:
      - "🚀 节点选择"
      - DIRECT
  - name: "🇨🇳 中国"
    type: select
    include-all: true
    proxies:
      - DIRECT
  - name: "🐟 漏网之鱼"
    type: select
    include-all: true
    proxies:
      - "🚀 节点选择"
      - DIRECT

# AI > 社交媒体 > 中国域名 > 中国IP > 漏网之鱼
# no-resolve: 只匹配已经是 IP 的连接，不再为域名做额外解析
rules:
  - DOMAIN,api64.ipify.org,DIRECT
  - RULE-SET,AI-OpenAI,🤖 AI
  - RULE-SET,AI-Global,🤖 AI
  - RULE-SET,Twitter,📱 社交媒体
  - RULE-SET,Instagram,📱 社交媒体
  - RULE-SET,China,🇨🇳 中国
  - GEOIP,private,DIRECT,no-resolve
  - GEOIP,cn,🇨🇳 中国,no-resolve
  - MATCH,🐟 漏网之鱼

listeners:
@@LISTENERS@@
